<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No permissions. Not one.

      The first constraint of this app is that it never touches the network, and
      the honest way to say so on Android is to ask for nothing — no INTERNET, no
      storage, no anything. A reviewer can confirm the promise from this file
      alone, which is worth more than a sentence in a privacy policy.
    -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stockbook">

        <!--
          `adjustResize`, not `adjustNothing`.
          `adjustNothing` was chosen to mirror the iOS rule that the keyboard
          overlays the app rather than moving it. That rule works on iOS because
          the system still scrolls a focused field into view inside a scroll view,
          so nothing is ever hidden. Android does no such thing: with
          `adjustNothing` any field below the keyboard line was simply covered,
          with no way to scroll to it. The layout moving is the lesser cost by a
          long way — see the `imePadding` calls that go with this.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Stockbook">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No permissions. Not one — and this file is not the whole story, so here is
      the rest of it.

      The first constraint of this app is that it never touches the network, and
      the honest way to say so on Android is to ask for nothing: no INTERNET, no
      storage, no anything. Nothing is requested here, and CI asks the built APK
      directly rather than trusting this file, because every library's manifest is
      merged into it.

      That check permits exactly one line, which `androidx.core` contributes:
      a signature-level permission named `${applicationId}.DYNAMIC_RECEIVER_NOT_
      EXPORTED_PERMISSION`, defined by this APK and grantable only to this APK, so
      a runtime-registered receiver can be marked not-exported on API 33+. It asks
      nothing of the phone and raises no dialog. It has been in the merged manifest
      since long before it was noticed — `androidx.core` arrives underneath
      `activity-compose` whether or not it is named in `build.gradle.kts` — and it
      was the permission check, added later, that made it visible.
    -->

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stockbook">

        <!--
          `adjustResize`, not `adjustNothing`.
          `adjustNothing` was chosen to mirror the iOS rule that the keyboard
          overlays the app rather than moving it. That rule works on iOS because
          the system still scrolls a focused field into view inside a scroll view,
          so nothing is ever hidden. Android does no such thing: with
          `adjustNothing` any field below the keyboard line was simply covered,
          with no way to scroll to it. The layout moving is the lesser cost by a
          long way — see the `imePadding` calls that go with this.
        -->
        <!--
          `screenOrientation` is a request rather than a rule from `targetSdk
          36`. Android 16 ignores orientation and resizability restrictions on
          displays 600dp and wider, so a tablet or an unfolded foldable rotates
          this app whatever the attribute says. Phones — every device this is
          actually for, a shopkeeper's hand at a counter — still honour it.

          Left in place deliberately: it still does its job where it matters, and
          removing it would change nothing on a large screen while letting phones
          rotate too.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Stockbook">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          How a statement PDF leaves the app.

          A `<provider>`, not a permission: it declares nothing the phone's owner
          is asked about and nothing another app can hold. `grantUriPermissions`
          hands out read access to **one file at a time**, for as long as the
          share sheet needs it, from the app's own cache and nowhere else — see
          `res/xml/shared_files.xml`. `exported="false"` means no other app can
          address the provider directly; only a URI this app has granted works.

          The alternative was writing the PDF somewhere shared, which would need
          a storage permission, which this app is never going to ask for.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>
</manifest>

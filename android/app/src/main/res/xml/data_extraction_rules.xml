<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device, including via Google's own backup transport.

  "All persistence is local" would be a half-truth if the shop were quietly
  synced to a Google account behind the owner's back. The only copy that leaves
  this phone is the file the owner exports on purpose.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
